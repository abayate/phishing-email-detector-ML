# Server
APP_NAME=PhishGuard
APP_ENV=dev
API_KEY=dev-key-change-me
CORS_ORIGINS=http://localhost:5173
DATABASE_PATH=./phishguard.db

# Model
MODEL_DIR=./phishing_model
RISK_THRESHOLD=0.78

# Automation
AUTO_QUARANTINE=false
POLL_INTERVAL_SECONDS=120

# Optional notifications (email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_TO_EMAIL=

# Gmail OAuth (optional)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/integrations/gmail/callback

# Microsoft OAuth (optional)
MS_TENANT_ID=common
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:8000/integrations/outlook/callback

# Encryption (for tokens at rest)
# Generate one with: python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
TOKENS_FERNET_KEY=
